---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title ? `${title} | Island` : "Island"}</title>
  <style>
    :root {
      --bg: #ffffff;
      --text: #222222;
      --link: #222222;
      --border: #ddd;
    }
    [data-theme="dark"] {
      --bg: #111111;
      --text: #e9e9e9;
      --link: #e9e9e9;
      --border: #333;
    }
    * {
      box-sizing: border-box;
    }
    body {
      margin: 0;
      font-family: Georgia, serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      max-width: 680px;
      padding: 4rem 24px;
      margin-inline: auto;
      transition: background 0.2s, color 0.2s;
    }
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 4rem;
    }
    .nav-links a {
      margin-left: 18px;
    }
    a {
      color: var(--link);
      text-decoration: none;
      border-bottom: 1px solid var(--border);
    }
    a:hover {
      border-bottom-color: var(--text);
    }
    .theme-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      padding: 4px 8px;
      cursor: pointer;
      border-radius: 4px;
    }
    h1 {
      font-size: 2.2rem;
      font-weight: normal;
    }
    h2 {
      font-size: 1.5rem;
      font-weight: normal;
      margin-top: 2em;
    }
    p {
      margin: 1rem 0;
    }
    ul {
      padding-left: 20px;
    }
  </style>
</head>
<body data-theme={Astro.cookies.get("theme")?.value ?? "light"}>
  <nav>
    <a href="/">Island</a>
    <div class="nav-links">
      <a href="/about">About</a>
      <a href="/projects">Projects</a>
      <button class="theme-btn" id="toggle">暗/亮</button>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <script>
    const btn = document.querySelector("#toggle");
    const body = document.body;
    btn.onclick = () => {
      const next = body.dataset.theme === "dark" ? "light" : "dark";
      body.dataset.theme = next;
      document.cookie = `theme=${next};path=/`;
    }
  </script>
</body>
</html>
